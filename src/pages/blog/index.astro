---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import CategoryNav from '../../components/CategoryNav.astro'
import { categoryIds } from '../../config/categories'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const categoryStats = categoryIds
  .map((id) => ({ id, count: posts.filter((post) => post.data.category === id).length }))
  .filter(({ count }) => count > 0)
---

<BaseLayout title="文章" description="技术实践、学习笔记与思考">
  <div class="page">
    <header class="page-header">
      <h1>文章</h1>
      <p class="sub">技术实践、学习笔记与思考。<a href="/rss.xml">订阅 RSS</a></p>
    </header>
    <CategoryNav items={categoryStats} />
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 1.75rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.7rem;
  }

  .sub {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
