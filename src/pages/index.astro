---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import CategoryNav from '../components/CategoryNav.astro'
import { categoryIds } from '../config/categories'

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const categoryStats = categoryIds
  .map((id) => ({ id, count: allPosts.filter((post) => post.data.category === id).length }))
  .filter(({ count }) => count > 0)
---

<BaseLayout>
  <div class="page">
    <header class="hero">
      <h1>masp 的笔记</h1>
      <p class="intro">
        关于系统、工程与持续学习的个人笔记。把复杂问题拆开，也把实践中的答案留下来。
      </p>
    </header>
    <CategoryNav items={categoryStats} />
    <div class="post-list">
      {allPosts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 1.75rem;
  }

  h1 {
    margin: 0 0 0.6rem;
    font-size: 1.7rem;
  }

  .intro {
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .post-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
