---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="页面未找到" description="你访问的页面不存在">
  <div class="page">
    <h1>404</h1>
    <p>这里什么也没有。</p>
    <p><a href="/">返回首页</a></p>
  </div>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 1rem;
    font-size: 1.7rem;
  }

  p {
    margin-block: 0.75rem;
    color: var(--muted);
  }
</style>
