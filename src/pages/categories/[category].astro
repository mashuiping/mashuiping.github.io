---
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import CategoryNav from '../../components/CategoryNav.astro'
import { categories, categoryIds, type CategoryId } from '../../config/categories'

export const getStaticPaths = (async () => {
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  const stats = categoryIds
    .map((id) => ({ id, count: allPosts.filter((post) => post.data.category === id).length }))
    .filter(({ count }) => count > 0)

  return stats.map(({ id }) => ({
    params: { category: id },
    props: {
      category: id,
      posts: allPosts.filter((post) => post.data.category === id),
      stats
    }
  }))
}) satisfies GetStaticPaths

const { category, posts, stats } = Astro.props as {
  category: CategoryId
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>
  stats: Array<{ id: CategoryId; count: number }>
}
const current = categories[category]
---

<BaseLayout title={current.label} description={current.description}>
  <div class="page">
    <header class="page-header">
      <h1>{current.label}</h1>
      <p class="sub">{current.description}</p>
    </header>
    <CategoryNav items={stats} active={category} />
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 1.75rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.7rem;
  }

  .sub {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
