---
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import CategoryNav from '../../components/CategoryNav.astro'
import { categories, categoryIds, type CategoryId } from '../../config/categories'

export const getStaticPaths = (async () => {
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  const stats = categoryIds
    .map((id) => ({ id, count: allPosts.filter((post) => post.data.category === id).length }))
    .filter(({ count }) => count > 0)

  return stats.map(({ id }) => ({
    params: { category: id },
    props: {
      category: id,
      posts: allPosts.filter((post) => post.data.category === id),
      stats
    }
  }))
}) satisfies GetStaticPaths

const { category, posts, stats } = Astro.props as {
  category: CategoryId
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>
  stats: Array<{ id: CategoryId; count: number }>
}
const current = categories[category]
---

<BaseLayout title={current.label} description={current.description}>
  <section class="page-shell">
    <header>
      <p>CATEGORY</p>
      <h1>{current.label}</h1>
      <span>{current.description}</span>
    </header>
    <CategoryNav items={stats} active={category} />
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page-shell {
    width: min(100% - 2rem, var(--content-width));
    margin-inline: auto;
    padding: clamp(4rem, 10vw, 7rem) 0 5rem;
  }

  header {
    padding-bottom: 3rem;
  }

  header > p {
    margin: 0 0 1rem;
    color: var(--accent);
    font-family: ui-monospace, monospace;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 6rem);
    letter-spacing: -0.065em;
  }

  header > span {
    display: block;
    margin-top: 1rem;
    color: var(--text-muted);
  }
</style>
