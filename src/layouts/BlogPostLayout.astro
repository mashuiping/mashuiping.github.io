---
import type { MarkdownHeading } from 'astro'
import BaseLayout from './BaseLayout.astro'
import { categories, type CategoryId } from '../config/categories'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  category: CategoryId
  tags: string[]
  headings?: MarkdownHeading[]
}

const { title, description, pubDate, updatedDate, category, tags, headings = [] } = Astro.props
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const hasToc = tocItems.length >= 2
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})
---

<BaseLayout title={title} description={description}>
  <div class:list={['post-grid', { 'has-toc': hasToc }]}>
    {hasToc && (
      <aside class="toc-side">
        <nav class="toc" aria-label="目录">
          <h2>目录</h2>
          <ul>
            {tocItems.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
    <article class="post-shell">
      <header class="post-header">
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <span>更新于 {formatDate(updatedDate)}</span>}
          <a class="pill category" href={`/categories/${category}/`}>{categories[category].label}</a>
          {tags.map((tag) => <span class="pill">{tag}</span>)}
        </div>
      </header>
      {hasToc && (
        <details class="toc-inline">
          <summary>目录</summary>
          <ul>
            {tocItems.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )}
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>

  <script>
    const diagrams = Array.from(document.querySelectorAll<HTMLElement>('pre > code.language-mermaid'))
      .map((code) => {
        const container = code.parentElement
        if (!container) return null

        container.className = 'mermaid'
        container.textContent = code.textContent
        return container
      })
      .filter((node): node is HTMLElement => node !== null)

    if (diagrams.length > 0) {
      const { default: mermaid } = await import('mermaid')

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'dark',
        themeVariables: { darkMode: true, background: '#22221e' }
      })
      await mermaid.run({ nodes: diagrams })
    }
  </script>

  <script>
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'))

    if (tocLinks.length > 0) {
      const linkBySlug = new Map(tocLinks.map((link) => [decodeURIComponent(link.hash.slice(1)), link]))
      const sections = Array.from(linkBySlug.keys())
        .map((slug) => document.getElementById(slug))
        .filter((el): el is HTMLElement => el !== null)

      let activeLink: HTMLAnchorElement | undefined

      const setActive = (slug: string) => {
        const link = linkBySlug.get(slug)
        if (!link || link === activeLink) return
        activeLink?.classList.remove('active')
        link.classList.add('active')
        activeLink = link
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive(entry.target.id)
          }
        },
        { rootMargin: '-10% 0px -75% 0px' }
      )

      sections.forEach((section) => observer.observe(section))
    }
  </script>
</BaseLayout>

<style>
  .post-grid {
    width: min(100% - 2.5rem, var(--content-width));
    margin-inline: auto;
  }

  .post-grid.has-toc {
    display: grid;
    width: min(100% - 2.5rem, var(--wide-width));
    grid-template-columns: 15rem minmax(0, var(--content-width));
    justify-content: center;
    gap: 5rem;
  }

  .toc-side {
    font-family: var(--sans);
  }

  .toc {
    position: sticky;
    top: 5.2rem;
    max-height: calc(100vh - 6.5rem);
    overflow-y: auto;
    padding: 1.5rem 0 1rem;
  }

  .toc h2 {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toc ul,
  .toc-inline ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    border-radius: 4px;
    padding: 0.28rem 0.55rem;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .toc li.depth-3 a {
    padding-left: 1.4rem;
    font-size: 0.76rem;
  }

  .toc a:hover {
    color: var(--fg-strong);
    background: var(--bg3);
    text-decoration: none;
  }

  .toc a:global(.active) {
    color: var(--accent-bright);
    background: var(--bg3);
  }

  .post-shell {
    padding: 2.5rem 0 5rem;
  }

  .post-header {
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.3;
  }

  .lead {
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.2rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.8rem;
  }

  .pill {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    background: var(--bg3);
  }

  .category {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    color: var(--accent-bright);
    text-decoration: none;
  }

  .category:hover {
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .toc-inline {
    display: none;
    margin-top: 1.4rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.7rem 1rem;
    background: var(--bg2);
    font-family: var(--sans);
    font-size: 0.85rem;
  }

  .toc-inline summary {
    color: var(--muted);
    font-weight: 600;
    cursor: pointer;
  }

  .toc-inline ul {
    margin-top: 0.5rem;
  }

  .toc-inline a {
    display: block;
    padding: 0.22rem 0;
    color: var(--muted);
    text-decoration: none;
  }

  .toc-inline a:hover {
    color: var(--fg-strong);
  }

  .toc-inline li.depth-3 a {
    padding-left: 1.2rem;
  }

  .prose {
    padding-top: 1.6rem;
  }

  @media (max-width: 980px) {
    .post-grid.has-toc {
      display: block;
      width: min(100% - 2.5rem, var(--content-width));
    }

    .toc-side {
      display: none;
    }

    .toc-inline {
      display: block;
    }
  }
</style>
