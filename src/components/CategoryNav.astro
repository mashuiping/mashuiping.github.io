---
import { categories, type CategoryId } from '../config/categories'

interface Props {
  items: Array<{ id: CategoryId; count: number }>
  active?: CategoryId
}

const { items, active } = Astro.props
---

<nav class="category-nav" aria-label="文章分类">
  <a href="/blog/" aria-current={!active ? 'page' : undefined}>
    全部
  </a>
  {items.map(({ id, count }) => (
    <a href={`/categories/${id}/`} aria-current={active === id ? 'page' : undefined}>
      {categories[id].label}<span>{count}</span>
    </a>
  ))}
</nav>

<style>
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    gap: 0.55rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    color: var(--text-muted);
    background: var(--background);
    font-size: 0.88rem;
    text-decoration: none;
  }

  a:hover,
  a[aria-current='page'] {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--background));
  }

  span {
    color: inherit;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    opacity: 0.7;
  }
</style>
