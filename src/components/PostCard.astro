---
import type { CollectionEntry } from 'astro:content'
import { categories } from '../config/categories'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const isoDate = post.data.pubDate.toISOString().slice(0, 10)
---

<article>
  <div class="post-head">
    <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
    <time datetime={post.data.pubDate.toISOString()}>{isoDate}</time>
  </div>
  <p class="description">{post.data.description}</p>
  <p class="post-meta">
    <a class="category" href={`/categories/${post.data.category}/`}>{categories[post.data.category].label}</a>
    {post.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
  </p>
</article>

<style>
  article {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .post-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
  }

  h2 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.45;
  }

  h2 a {
    color: var(--fg-strong);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent-bright);
    text-decoration: none;
  }

  time {
    flex-shrink: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .description {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0.7rem 0 0;
    font-family: var(--sans);
    font-size: 0.76rem;
  }

  .category {
    color: var(--accent-bright);
    text-decoration: none;
  }

  .category:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .tag {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.08rem 0.5rem;
    color: var(--muted);
    background: var(--bg2);
  }

  @media (max-width: 560px) {
    .post-head {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
