---
import type { CollectionEntry } from 'astro:content'
import { categories } from '../config/categories'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})
---

<article>
  <div class="post-meta">
    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true">·</span>
    <a class="category" href={`/categories/${post.data.category}/`}>
      {categories[post.data.category].label}
    </a>
    {post.data.tags.length > 0 && <span aria-hidden="true">·</span>}
    {post.data.tags.map((tag) => <span>{tag}</span>)}
  </div>
  <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <a class="read-more" href={`/blog/${post.id}/`} aria-label={`阅读《${post.data.title}》`}>
    阅读文章 <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  article {
    padding-block: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.86rem;
  }

  .category {
    color: var(--accent);
    font-weight: 650;
    text-decoration: none;
  }

  .category:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h2 {
    margin: 0.65rem 0 0.6rem;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    letter-spacing: -0.03em;
  }

  h2 a {
    color: var(--text-strong);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  p {
    max-width: 42rem;
    margin: 0;
    color: var(--text-muted);
  }

  .read-more {
    display: inline-flex;
    margin-top: 1rem;
    gap: 0.35rem;
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
  }
</style>
