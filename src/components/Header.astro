---
const pathname = Astro.url.pathname

const links = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/about/', label: '关于' }
]
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="masp 的博客首页">
      <span class="brand-mark" aria-hidden="true"></span>
      masp<span class="brand-note">/ notes</span>
    </a>
    <nav aria-label="主导航">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: rgba(23, 23, 20, 0.88);
    backdrop-filter: blur(14px);
    font-family: var(--sans);
  }

  .header-inner {
    display: flex;
    width: min(100% - 2.5rem, var(--wide-width));
    min-height: 3.4rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg-strong);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(255, 118, 88, 0.18);
  }

  .brand-note {
    margin-left: 0.15rem;
    color: var(--muted);
    font-weight: 450;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
    list-style: none;
  }

  nav a {
    display: block;
    border-radius: 4px;
    padding: 0.3rem 0.7rem;
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--fg-strong);
    background: var(--bg3);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--accent-bright);
    background: var(--bg3);
  }

  @media (max-width: 520px) {
    .brand-note {
      display: none;
    }
  }
</style>
